# InjuryAI Platform Environment Configuration

# Server Port (Default: 5000)
PORT=5000

# Security & Admin Access
ADMIN_PASSCODE=admin123

# Smart AI Assistant (Google Gemini 1.5/2.0 API)
# Get your API key at: https://aistudio.google.com/
# If left blank, InjuryAI automatically activates its built-in clinical triage rule engine with full CPR, bleeding, burns, and first-aid protocols.
GEMINI_API_KEY=

# Firebase Cloud Firestore & Storage (Optional)
# If left blank, InjuryAI automatically operates in high-performance demo in-memory storage with pre-seeded verified hospitals, volunteers, and emergency telemetry.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=
